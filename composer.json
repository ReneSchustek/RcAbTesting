{
    "name": "ruhrcoder/rc-ab-testing",
    "description": "A/B-Tests für Shopware: Twig-/Theme-/Feature-Flag-Varianten mit Sticky-Bucketing, Funnel-Tracking und Auswertung.",
    "version": "1.4.0",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Ruhrcoder",
            "homepage": "https://ruhrcoder.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.7.0",
        "shopware/storefront": "~6.7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "phpstan/phpstan": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "extra": {
        "shopware-plugin-class": "Ruhrcoder\\RcAbTesting\\RcAbTesting",
        "label": {
            "de-DE": "A/B-Tests",
            "en-GB": "A/B Testing"
        },
        "description": {
            "de-DE": "A/B-Tests für Shopware: Twig-/Theme-/Feature-Flag-Varianten mit Sticky-Bucketing pro Besucher, Funnel-Tracking über Cart, Order, Login und Auswertung mit Konfidenzintervallen.",
            "en-GB": "A/B testing for Shopware: Twig/theme/feature-flag variants with sticky per-visitor bucketing, cart/order/login funnel tracking, and statistical evaluation."
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "Ruhrcoder\\RcAbTesting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruhrcoder\\RcAbTesting\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    }
}
